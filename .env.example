# ==========================================
# ANTIGRAVITY ROOT ENVIRONMENT CONFIGURATION
# ==========================================

# Environment Mode
NODE_ENV=development

# ------------------------------------------
# Supabase (Database & Authentication)
# ------------------------------------------
SUPABASE_URL=https://placeholder.supabase.co
SUPABASE_ANON_KEY=placeholder-anon-key
SUPABASE_SERVICE_ROLE_KEY=placeholder-service-role-key

# ------------------------------------------
# Upstash Redis (Rate Limiting & Room Codes)
# ------------------------------------------
REDIS_URL=rediss://default:placeholder@placeholder.upstash.io:6379

# ------------------------------------------
# API Configuration
# ------------------------------------------
PORT=3001
API_BASE_URL=http://localhost:3001
CORS_ORIGIN=http://localhost:3000

# ------------------------------------------
# Wallet Configuration
# Modes: demo (POINTS) | mpesa (stub) | paystack (stub) | crypto (stub)
# ------------------------------------------
WALLET_MODE=demo
PLATFORM_RAKE_PERCENT=5

# ------------------------------------------
# Optiic / Fallback OCR (Optional)
# ------------------------------------------
OPTIIC_API_KEY=

# ------------------------------------------
# Frontend Environment Variables
# ------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://placeholder.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=placeholder-anon-key
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_WALLET_MODE=demo

# ------------------------------------------
# Mobile Environment Variables
# ------------------------------------------
EXPO_PUBLIC_SUPABASE_URL=https://placeholder.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=placeholder-anon-key
EXPO_PUBLIC_API_URL=http://localhost:3001
