PORT=4000
NODE_ENV=development

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

DATABASE_URL=postgresql://postgres:postgres@localhost:54322/postgres

UPSTASH_REDIS_URL=redis://default:token@your-redis.upstash.io:6379
UPSTASH_REDIS_TOKEN=your-token

R2_ACCOUNT_ID=your-account-id
R2_ACCESS_KEY_ID=your-access-key-id
R2_SECRET_ACCESS_KEY=your-secret-access-key
R2_BUCKET=antigravity-frames
R2_PUBLIC_URL=https://frames.antigravity.gg

WALLET_MODE=demo

OPTIIC_API_KEY=your-optiic-key
TWITCH_CLIENT_ID=your-twitch-client-id
TWITCH_CLIENT_SECRET=your-twitch-client-secret
YOUTUBE_API_KEY=your-youtube-api-key

ENABLE_STREAM_INGEST=false
ENABLE_REAL_MONEY=false
ENABLE_KYC=false

WEB_URL=http://localhost:3000
JWT_SECRET=change-me-in-prod
