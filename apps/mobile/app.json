{
  "expo": {
    "name": "VerzusXYZ",
    "slug": "verzusxyz",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "verzusxyz",
    "userInterfaceStyle": "dark",
    "splash": {
      "backgroundColor": "#0A0A0F"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "xyz.verzus.app"
    },
    "android": {
      "package": "xyz.verzus.app"
    },
    "plugins": ["expo-router", "expo-secure-store"],
    "experiments": {
      "typedRoutes": true
    }
  }
}
